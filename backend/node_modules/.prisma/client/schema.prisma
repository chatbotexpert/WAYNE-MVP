datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  password_hash    String
  role             String
  company_id       String?
  company          Company?         @relation(fields: [company_id], references: [id])
  permission_flags PermissionFlags?
  created_at       DateTime         @default(now())

  workforce_assignments WorkforceAssignment[]
  metrics_recorded      MetricData[]
  supervised_workforce  Workforce[]           @relation("SupervisorWorkforce")
  managed_workforce     Workforce[]           @relation("ManagerWorkforce")
}

model Company {
  id                      String    @id @default(uuid())
  company_number          String?
  name                    String
  registered_address      String?
  company_reg_number      String?
  vat_no                  String?
  tel_no                  String?
  email                   String?
  accounts_contact_name   String?
  accounts_address        String?
  accounts_contact_number String?
  accounts_email          String?
  notes_prices_agreed     String?
  size                    String?
  max_tm                  Int       @default(0)
  max_sup                 Int       @default(0)
  max_departments         Int       @default(0)
  main_contact            String?
  deleted_at              DateTime?
  created_at              DateTime  @default(now())

  users      User[]
  workforces Workforce[]
}

model Workforce {
  id                   String    @id @default(uuid())
  workforce_number     String?
  name                 String
  department           String?
  candidate_address    String?
  email                String?
  contact_number       String?
  date_of_birth        DateTime?
  ni_number            String?
  cscs_expiry          DateTime?
  swqr_expiry          DateTime?
  eusr_expiry          DateTime?
  cscs_number          String?
  swqr_number          String?
  eusr_number          String?
  npors_number         String?
  in_house_cert_number String?

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  supervisor_id String?
  supervisor    User?   @relation("SupervisorWorkforce", fields: [supervisor_id], references: [id])

  training_manager_id String?
  training_manager    User?   @relation("ManagerWorkforce", fields: [training_manager_id], references: [id])

  deleted_at             DateTime?
  consent_date           DateTime?
  privacy_policy_version String?
  created_at             DateTime  @default(now())

  assignments     WorkforceAssignment[]
  metric_data     MetricData[]
  npors_metrics   NporsMetric[]
  nrswa_metrics   NrswaMetric[]
  eusr_metrics    EusrMetric[]
  inhouse_metrics InhouseMetric[]
  nvq_metrics     NvqMetric[]
}

model WorkforceAssignment {
  id           String    @id @default(uuid())
  workforce_id String
  user_id      String
  workforce    Workforce @relation(fields: [workforce_id], references: [id])
  user         User      @relation(fields: [user_id], references: [id])

  @@unique([workforce_id, user_id])
}

model Metric {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., NPORS, EUSR, NVQ, In-House Certificate, NRSWA
  description String?

  metric_data MetricData[]
}

model MetricData {
  id           String   @id @default(uuid())
  metric_id    String
  workforce_id String
  value        String // Value or score
  recorded_by  String
  recorded_at  DateTime @default(now())

  metric    Metric    @relation(fields: [metric_id], references: [id])
  workforce Workforce @relation(fields: [workforce_id], references: [id])
  admin     User      @relation(fields: [recorded_by], references: [id])
}

model NporsMetric {
  id           String    @id @default(uuid())
  workforce_id String
  workforce    Workforce @relation(fields: [workforce_id], references: [id])

  training_date     DateTime?
  training_address  String?
  on_number         String?
  novice_or_ewt     String?
  expiry            DateTime?
  tester            String?
  date_pw_uploaded  DateTime?
  cards_posted_info String?
  category          String?

  created_at DateTime @default(now())
}

model NrswaMetric {
  id           String    @id @default(uuid())
  workforce_id String
  workforce    Workforce @relation(fields: [workforce_id], references: [id])

  training_date   DateTime?
  expiry_date     DateTime?
  category        String? // Streetworks Category
  certs_applied   Boolean   @default(false)
  certs_sent_date DateTime?
  certs_sent_to   String?
  course          String?

  created_at DateTime @default(now())
}

model EusrMetric {
  id           String    @id @default(uuid())
  workforce_id String
  workforce    Workforce @relation(fields: [workforce_id], references: [id])

  training_date     DateTime?
  batch_number      String?
  expiry            DateTime?
  category          String? // Eusr Category
  date_resulted     DateTime?
  card_type         String?
  dates_card_posted DateTime?
  notes             String?

  created_at DateTime @default(now())
}

model InhouseMetric {
  id           String    @id @default(uuid())
  workforce_id String
  workforce    Workforce @relation(fields: [workforce_id], references: [id])

  course_date    DateTime?
  expiry_date    DateTime?
  customer       String?
  cert_sent_date DateTime?
  certs_sent_to  String?
  notes          String?
  category       String? // Certificate Category

  created_at DateTime @default(now())
}

model NvqMetric {
  id           String    @id @default(uuid())
  workforce_id String
  workforce    Workforce @relation(fields: [workforce_id], references: [id])

  nvq_title                       String?
  bolt_on_nvq                     String?
  uln_number                      String?
  po_number                       String?
  card_scheme_category            String?
  site_address                    String?
  site_contact_info               String?
  english_understanding_confirmed Boolean   @default(false)
  tc_acknowledged                 Boolean   @default(false)
  gdpr_consent                    Boolean   @default(false)
  card_extension_date             DateTime?
  date_registered                 DateTime?
  date_induction_booked           DateTime?
  stage_of_nvq                    String?
  notes                           String?
  completed_date                  DateTime?
  certification_date              DateTime?

  created_at DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  user_id       String
  action        String // e.g., 'CREATE', 'UPDATE', 'DELETE', 'EXPORT'
  target_entity String // e.g., 'Workforce', 'Company'
  target_id     String?
  timestamp     DateTime @default(now())
  ip_address    String?
  details       String? // JSON stringified details
}

model PermissionFlags {
  id      String @id @default(uuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  can_manage_users       Boolean @default(false)
  can_manage_billing     Boolean @default(false)
  can_export_data        Boolean @default(false)
  can_delete_records     Boolean @default(false)
  can_manage_permissions Boolean @default(false)

  created_at DateTime @default(now())
}
